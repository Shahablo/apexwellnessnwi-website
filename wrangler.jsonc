{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apexwellnessnwi-website",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "apexwellnessnwi.com",
      "custom_domain": true
    },
    {
      "pattern": "www.apexwellnessnwi.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/api/*",
      "/google07a86ae9e08bbe79.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "apexwellness-priority",
      "database_id": "a6ba6c22-70f0-4eff-abe3-75dce9d97701",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APPOINTMENT_REQUESTS_ENABLED": "true",
    "BREVO_SENDER_EMAIL": "shahab@apexwellnessnwi.com",
    "BREVO_REPLY_TO_EMAIL": "shahab@apexwellnessnwi.com",
    "FOUNDING_CONSENT_VERSION": "launch-list-split-2026-10-26",
    "LAUNCH_EMAIL_ENABLED": "false",
    "LAUNCH_EMAIL_FOLLOWUPS_ENABLED": "false"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
